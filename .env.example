# Copy as .env and fill in your own SQL Server account.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=RFOID_TrackGuard;encrypt=true;trustServerCertificate=true
DB_USERNAME=rfoid_app
DB_PASSWORD=
RFOID_PYTHON=python
RFOID_MODEL=ai-core/models/trackguard-world.pt
RFOID_WORKER=ai-core/worker.py
RFOID_STORAGE=storage
RFOID_TIMEOUT=300
# Maximum time allowed for the Python worker to import its dependencies.
RFOID_WORKER_STARTUP_TIMEOUT=180
# GPU video batch (1..8); CPU always uses 1. Lower this value if GPU memory is limited.
RFOID_BATCH_SIZE=8
# Model input long edge, multiple of 32, 320..1280. Lower values can miss small objects.
RFOID_IMAGE_SIZE=640
# FP16 on CUDA; CPU always uses FP32. Restart backend after changing inference options.
RFOID_HALF=true
RFOID_CPU_THREADS=4
# Optional image understanding, called by ai-core/vision_advice.py. A video request sends the complete structured detection result
# plus at most DEEPSEEK_MAX_IMAGES selected change/key frames, never every frame or the source video.
# Failures keep the built-in local rule advice.
DEEPSEEK_VISION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15
DEEPSEEK_MAX_IMAGES=8
# Optional: set the full path to mvn.cmd if Maven is not on PATH.
# MAVEN_CMD=C:\path\to\apache-maven\bin\mvn.cmd
